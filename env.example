# Standalone ChatBridge Compose synthetic environment template (non-production defaults only).
# Replace all passwords and cryptographic secrets before running in staging or production.

COMPOSE_PROJECT_NAME=chatbridge

CHATBRIDGE_ENV=development
CHATBRIDGE_HOST=0.0.0.0
CHATBRIDGE_PORT=4200
CHATBRIDGE_HOST_PORT=4200
CHATBRIDGE_PROBE_DATABASE=true
CHATBRIDGE_WORKER_POLL_INTERVAL_MS=2000
CHATBRIDGE_ALLOW_BLIND_SEND_RETRY=false

# Dedicated ChatBridge PostgreSQL database, owner (migrations only), and runtime DML role
CHATBRIDGE_PG_DB=chatbridge_db
CHATBRIDGE_PG_ADMIN_USER=chatbridge_owner
CHATBRIDGE_PG_ADMIN_PASSWORD=synthetic_pg_admin_password_change_me
CHATBRIDGE_DB_APP_USER=chatbridge_runtime
CHATBRIDGE_DB_APP_PASSWORD=synthetic_pg_app_password_change_me
CHATBRIDGE_DATABASE_URL=postgres://chatbridge_runtime:synthetic_pg_app_password_change_me@postgres:5432/chatbridge_db?sslmode=disable

# Cryptographic service & webhook signing keys (minimum 32 characters each)
CHATBRIDGE_INTEGRATION_HMAC_SECRET=synthetic-dev-integration-hmac-secret-minimum-32-chars
CHATBRIDGE_WEBHOOK_SIGNING_SECRET=synthetic-dev-webhook-signing-secret-minimum-32-chars

# Object storage endpoint and synthetic credentials (non-production)
CHATBRIDGE_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:8333
CHATBRIDGE_OBJECT_STORAGE_ACCESS_KEY_ID=synthetic-storage-access-key
CHATBRIDGE_OBJECT_STORAGE_SECRET_ACCESS_KEY=synthetic-storage-secret-key-minimum-24
